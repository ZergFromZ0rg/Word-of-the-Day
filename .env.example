# Copy this file to .env and fill in your keys (https://dictionaryapi.com/register/index).
# Both are optional: without them the free sources (Wiktionary, Datamuse) are used.

# Key for "Merriam-Webster's Collegiate Dictionary with Audio"
MW_DICTIONARY_KEY=

# Key for "Merriam-Webster's Collegiate Thesaurus" (synonyms and antonyms)
MW_THESAURUS_KEY=

# Time zone that decides when "today" starts. Defaults to the machine's own zone,
# which is usually UTC inside Docker.
# WOTD_TIMEZONE=America/Toronto

# Where the word list, history and cache live (command line and API)
# WOTD_WORDS_FILE=words.txt
# WOTD_HISTORY_FILE=history.json
# WOTD_CACHE_DIR=cache

# API server (word-of-the-day-api). Use WOTD_HOST=0.0.0.0 to accept other machines,
# e.g. inside Docker. CORS origins are comma-separated; the default "*" allows any page.
# WOTD_HOST=127.0.0.1
# WOTD_PORT=8000
# WOTD_CORS_ORIGINS=http://homelab.local:3000
